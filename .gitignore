.DS_Store

work/
*.pyc
__pycache__/
rebuild_1899/out/peek/
outputs/*/mosaic/
outputs/*/tiles/

# gridfit/streetcut/netsolve keep a .pre_* backup of what they replaced;
# git already holds that history
*.pre_city
*.pre_recut
*.pre_controls

# the COG is over GitHub's 100 MB file cap; rebuild with tools/publish.py
outputs/*/mosaic/*.tif
outputs/*/tiles/

# transcript HTML is an intermediate; the PDF is the deliverable
outputs/transcript/*.html

# seam crops: the 50% set is committed (the graders' evidence); the 100% set
# is 4x the bytes and regenerates with tools/seamcrops.py
outputs/*/qc/seams/seam_*_100.jpg
# regenerable QC crops (tools/seamcrops.py, periphery windows); the index.json and grades are tracked
outputs/1912/qc/seams/seam_*.jpg
outputs/1912/qc/periphery/edge_*.jpg
outputs/1912/qc/seams/seam_*.tif

# Print deliverables: rendered from the recipe by tools/printmaster.py.
# The wall master (271 MB), the single sheet (82 MB TIFF) and the DeepZoom
# pyramid are too large for the repository; the recipe that produces them is
# versioned instead. The 24 MB print PDF and the 12 MB preview are kept.
outputs/*/print/*wallmaster*.tif
outputs/*/print/*sheet*.tif
outputs/*/print/tiles/*.tif
outputs/*/print/tiles/*_tile_*.tif
outputs/1912/qc/**/_tmp_*
